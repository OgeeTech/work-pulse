{
  "manifest_version": 3,
  "name": "WorkPulse - Enterprise Time & Activity Tracker",
  "version": "1.1",
  "description": "Monitors active web domains, tracks focus time, and syncs time records.",
  "permissions": ["tabs", "storage", "idle", "alarms", "sidePanel"],
  "action": {
    "default_title": "Click to open WorkPulse panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
